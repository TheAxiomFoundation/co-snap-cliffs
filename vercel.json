{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/",
      "destination": "https://axiom.org/gallery/snap",
      "permanent": true
    },
    {
      "source": "/snap",
      "destination": "/gallery/snap",
      "permanent": false
    },
    {
      "source": "/snap/:path(.*)",
      "destination": "/gallery/snap/:path(.*)",
      "permanent": false
    }
  ],
  "functions": {
    "src/app/api/cliff-sweep/route.ts": { "maxDuration": 60 }
  }
}
